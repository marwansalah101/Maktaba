# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
OPENROUTER_API_KEY=your-openrouter-api-key-here
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Set to "production" in deployed environments. Enables secure cookies,
# strict CORS, and JSON logging.
NODE_ENV=development

# Comma-separated list of allowed frontend origins (production CORS only).
# e.g. https://maktaba.example.com,https://www.maktaba.example.com
ALLOWED_ORIGIN=

# Optional log level override (default: info in prod, debug in dev)
# LOG_LEVEL=info

# NOTE: Admin accounts are NORMAL users in the database with role:"admin".
# There is no longer an ADMIN_EMAIL/ADMIN_PASSWORD plaintext fallback.
